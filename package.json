{
  "name": "dewsharp",
  "version": "0.1.0",
  "private": true,
  "description": "C# in the browser, for teaching PDP (5N2927) and FOOP (5N0541).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:engine && npm run build:site",
    "build:engine": "node tools/build-engine.mjs",
    "build:site": "node tools/build-site.mjs",
    "serve": "node tools/serve.mjs",
    "test": "npm run test:parser && npm run test:engine && npm run test:page",
    "test:parser": "node tools/vendor.mjs --check && node --test tests/parser/*.test.mjs",
    "test:engine": "node --test --test-concurrency=1 tests/engine/*.test.mjs tests/tools/*.test.mjs",
    "check-lessons": "node tools/check-lessons.mjs",
    "vendor": "node tools/vendor.mjs",
    "test:page": "node --test --test-concurrency=1 tests/page/*.test.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@lezer/highlight": "1.2.4",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2",
    "katex": "0.18.9",
    "markdown-it": "15.0.2",
    "playwright": "1.56.1"
  }
}
